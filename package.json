{
  "name": "field-career-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build:web",
    "test": "npm run test -w apps/api -- --runInBand",
    "test:e2e": "npm run test:e2e -w apps/api",
    "prisma:generate": "npm run prisma:generate -w apps/api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
