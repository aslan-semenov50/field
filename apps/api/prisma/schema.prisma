generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum WorkFormat {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum SalaryPeriod {
  HOUR
  MONTH
  YEAR
  PROJECT
}

enum VacancyLifecycleStatus {
  ACTIVE
  CLOSED
  REMOVED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastLoginAt      DateTime?
  refreshSessions  RefreshSession[]
  candidateProfile CandidateProfile?
  searchProfiles   SearchProfile[]
  resumes          Resume[]
  hhConnection     HhConnection?
  hhOAuthState     HhOAuthState?

  @@map("users")
}

model RefreshSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model CandidateProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  locationText         String?
  countryCode          String?      @db.VarChar(2)
  city                 String?
  yearsOfExperience    Int?
  seniority            Seniority?
  professionalSummary  String?      @db.Text
  skills               String[]     @default([])
  languages            String[]     @default([])
  preferredWorkFormats WorkFormat[] @default([])
  primaryResumeId      String?      @unique
  primaryResume        Resume?      @relation("PrimaryResume", fields: [primaryResumeId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("candidate_profiles")
}

model SearchProfile {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  roleTitles         String[]         @default([])
  seniorities        Seniority[]      @default([])
  salaryMin          Decimal?         @db.Decimal(14, 2)
  salaryCurrency     String?          @db.VarChar(3)
  salaryPeriod       SalaryPeriod?
  requireKnownSalary Boolean          @default(false)
  countryCodes       String[]         @default([])
  cities             String[]         @default([])
  workFormats        WorkFormat[]     @default([])
  employmentTypes    EmploymentType[] @default([])
  requiredSkills     String[]         @default([])
  preferredSkills    String[]         @default([])
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId, isActive])
  @@map("search_profiles")
}

model Resume {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  languageCode      String   @db.VarChar(10)
  structuredContent Json?
  plainText         String?  @db.Text
  contentVersion    Int      @default(1)
  storageProvider   String?
  storageKey        String?
  originalFileName  String?
  mimeType          String?
  fileSizeBytes     Int?
  checksumSha256    String?
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  primaryForProfile CandidateProfile? @relation("PrimaryResume")

  @@index([userId, archivedAt])
  @@map("resumes")
}

model HhConnection {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hhUserId               String
  accessTokenCiphertext  String   @db.Text
  refreshTokenCiphertext String   @db.Text
  accessTokenExpiresAt   DateTime
  connectedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("hh_connections")
}

model HhOAuthState {
  stateHash              String   @id @db.VarChar(64)
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeVerifierCiphertext String   @db.Text
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  @@map("hh_oauth_states")
}

model VacancySource {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  vacancies Vacancy[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("vacancy_sources")
}

model Vacancy {
  id             String                   @id @default(cuid())
  sourceId       String
  source         VacancySource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId     String
  title          String
  companyName    String?
  description    String?                  @db.Text
  salaryMin      Decimal?                 @db.Decimal(14, 2)
  salaryMax      Decimal?                 @db.Decimal(14, 2)
  salaryCurrency String?                  @db.VarChar(3)
  salaryPeriod   SalaryPeriod?
  locationText   String?
  countryCode    String?                  @db.VarChar(2)
  city           String?
  workFormat     WorkFormat?
  employmentType EmploymentType?
  skills         String[]                 @default([])
  sourceUrl      String
  publishedAt    DateTime?
  lastSeenAt     DateTime
  status         VacancyLifecycleStatus   @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([sourceId, externalId])
  @@index([status, publishedAt, id])
  @@index([sourceId, status, publishedAt, id])
  @@map("vacancies")
}
